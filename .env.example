DATABASE_URL=postgresql://rfc:rfc@localhost:5433/rfc

# --- chat: stateless, so it may fall back and may be tiered ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=gpt-oss-20b-MXFP4-Q8
# optional bigger model, used only when the cheap one fails a check
LLM_MODEL_HEAVY=

# --- embeddings: a coordinate system, never falls back ---
# defaults to the chat endpoint when left blank
# local = fastembed in-process, no server, no rate limit
EMBED_BACKEND=local
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-small-en-v1.5-bf16
EMBED_DIM=384
# only needed when the provider's default size differs (Gemini)
EMBED_DIMENSIONS=

# direct | langchain | llamaindex   (langchain/llamaindex need: uv sync --group frameworks)
LLM_BACKEND=direct
LLM_FALLBACKS=

# observability
QUERY_LOG=1
LOG_LEVEL=WARNING

# One of these, matched to LLM_BASE_URL. LLM_API_KEY overrides all of them,
# and a local oMLX URL falls back to ~/.omlx/settings.json.
LLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# fallbacks:
#   Apple   LLM_BASE_URL=http://127.0.0.1:1976/v1   LLM_MODEL=system
#   OpenAI  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
